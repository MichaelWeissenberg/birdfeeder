# ============================================================================
# BIRDFEEDER ENVIRONMENT CONFIGURATION
# ============================================================================
#
# Copy this file to:
#
#   .env
#
# and adjust the values for your environment.
#
# Example:
#
#   cp .env.example .env
#
# ============================================================================

# ============================================================================
# TIMEZONE
# ============================================================================

# Local timezone used for:
# - observation timestamps
# - file names
# - web interface display
#
# Examples:
#
# Europe/Berlin
# Europe/London
# America/New_York
# UTC
#
TZ=Europe/Berlin

# ============================================================================
# CAMERA CONFIGURATION
# ============================================================================
#
# RTSP stream URL of the camera used by Birdfeeder.
#
# Birdfeeder captures a JPEG snapshot from this stream every
# INTERVAL_SECONDS seconds.
#
# Verify the stream manually before using Birdfeeder:
#
#   ffplay <rtsp-url>
#
# Common examples:
#
# Generic camera:
# rtsp://user:password@192.168.xxx.yyy:554/stream
#
# TP-Link Tapo Main Stream:
# rtsp://user:password@192.168.xxx.yyy:554/stream1
#
# TP-Link Tapo Sub Stream:
# rtsp://user:password@192.168.xxx.yyy:554/stream2
#
# Reolink Main Stream:
# rtsp://user:password@192.168.xxx.yyy:554/h264Preview_01_main
#
# Reolink Sub Stream:
# rtsp://user:password@192.168.xxx.yyy:554/h264Preview_01_sub
#
# Hikvision:
# rtsp://user:password@192.168.xxx.yyy:554/Streaming/Channels/101
#
# Dahua:
# rtsp://user:password@192.168.xxx.yyy:554/cam/realmonitor?channel=1&subtype=0
#
CAMERA_URL=rtsp://user:password@camera-ip:554/stream



# ============================================================================
# CORAL API
# ============================================================================
#
# URL of the CoralAPI instance.
#
# Birdfeeder does not access the EdgeTPU directly.
#
# Architecture:
#
# Camera
#   ↓
# Birdfeeder
#   ↓
# CoralAPI
#   ↓
# EdgeTPU
#
# Usually this can remain unchanged.
#
CORAL_API_URL=http://127.0.0.1:8001



# ============================================================================
# DETECTION SETTINGS
# ============================================================================
#
# Minimum confidence required for object detection.
#
# Lower values:
#   - More detections
#   - More false positives
#
# Higher values:
#   - Fewer detections
#   - More reliable detections
#
DETECTION_THRESHOLD=0.30



# ============================================================================
# SPECIES CLASSIFICATION SETTINGS
# ============================================================================
#
# Minimum confidence required for species acceptance.
#
# Example:
#
# Top prediction:
#   Eurasian Blackbird = 0.82
#
# Second prediction:
#   Common Starling = 0.11
#
# Accepted because:
#   score >= threshold
#   score difference >= margin
#
CLASSIFICATION_THRESHOLD=0.30

#
# Minimum confidence gap between the best and
# second-best species prediction.
#
CLASSIFICATION_MARGIN=0.10

# ============================================================================
# CLASSIFICATION FALLBACK
# ============================================================================
#
# If enabled, Birdfeeder may attempt classification using
# the full image when no suitable crop is available.
#
FULL_FRAME_FALLBACK=true

# Minimum score required for fallback classification.
#
FALLBACK_CLASSIFICATION_THRESHOLD=0.40

# Required difference between the best and second-best
# fallback prediction.
#
FALLBACK_CLASSIFICATION_MARGIN=0.20

# ============================================================================
# RUNTIME SETTINGS
# ============================================================================
#
# true  = run one capture and exit
# false = continuous operation
#
RUN_ONCE=false

#
# Time between capture cycles in seconds.
#
# Example:
#
# 5   = every 5 seconds
# 30  = every 30 seconds
# 300 = every 5 minutes
#
INTERVAL_SECONDS=5



# ============================================================================
# WEB INTERFACE
# ============================================================================
#
# Flask listening address.
#
WEB_HOST=0.0.0.0

#
# Flask listening port.
#
# Default:
#
# http://localhost:8080
#
WEB_PORT=8080

# Enable or disable web functionality.
#
# Current versions always use the dedicated birdfeeder-web
# service, but the variable is retained for compatibility.
#
WEB_ENABLED=true
